# Facebook Instant Games — meta build'i için derleme zamanı ayarları.
# Kullanım: bu dosyayı `.env.meta` olarak kopyala ve gerçek ID'leri gir.
# (.env.meta git'e GİRMEZ — .gitignore'da.)
#
# Placement ID'leri nereden alınır:
#   App Dashboard → Instant Games → Monetization / Ads → Create Placement
#   (Interstitial ve Rewarded Video için ayrı placement açılır)

VITE_FB_INTERSTITIAL_ID=
VITE_FB_REWARDED_ID=
